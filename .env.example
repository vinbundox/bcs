# Point this hostname's DNS A/AAAA records to your server before starting.
APP_DOMAIN=timber.example.com
TIMBER_COOKIE_SECURE=1
PREVIEW_PORT=8766
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Replace with a unique random value before deploying:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-output-of-python-secrets-token-hex-32
